APP_NAME=LibConnect API
ENVIRONMENT=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/libconnect?retryWrites=true&w=majority
MONGODB_DB=libconnect
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
FRONTEND_ORIGINS=http://localhost:5173
DEFAULT_BORROW_DAYS=14
MAX_BORROW_LIMIT=5
FINE_PER_DAY=1.00
